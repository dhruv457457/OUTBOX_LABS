# Values to set in the Render dashboard for the API service.
# Everything here also appears in backend/.env.example with fuller notes.

DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"
SUPABASE_URL="https://xxxx.supabase.co"

# Upstash (or any hosted Redis). Use the rediss:// URL for TLS.
REDIS_URL="rediss://default:PASSWORD@xxxx.upstash.io:6379"

ETHEREAL_USER=""
ETHEREAL_PASS=""

# The deployed dashboard's origin — without this the browser blocks every API call.
CORS_ORIGIN="https://your-app.vercel.app"

# Free plans run one process, so the queue worker lives inside the API.
RUN_WORKER_IN_API="true"

OPENROUTER_API_KEY=""
CLOUDINARY_URL=""
