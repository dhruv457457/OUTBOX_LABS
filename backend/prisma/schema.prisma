generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["scheduler"]
}

model Sender {
  id        String           @id @default(uuid())
  // Owning account — mailboxes belong to a user, so nobody can send "from" an
  // address that isn't theirs.
  userId    String
  email     String
  name      String?
  createdAt DateTime         @default(now())
  emails    ScheduledEmail[]

  @@unique([userId, email])
  @@index([userId])
  @@schema("scheduler")
}

model ScheduledEmail {
  id           String      @id @default(uuid())
  // Supabase auth user id (JWT `sub`) — every query is scoped to this so one account
  // can never see another's emails.
  userId       String
  senderId     String
  sender       Sender      @relation(fields: [senderId], references: [id])
  recipient    String
  subject      String
  bodyHtml     String
  scheduledFor DateTime
  minDelayMs   Int
  hourlyLimit  Int
  status       EmailStatus @default(SCHEDULED)
  batchId      String?
  starred      Boolean     @default(false)
  // [{ filename, contentType, url, bytes }] — files live in Cloudinary, the row only
  // keeps the reference.
  attachments  Json?
  attempt      Int         @default(0)
  lastError    String?
  sentAt       DateTime?
  previewUrl   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([senderId, status])
  @@index([batchId])
  @@schema("scheduler")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED

  @@schema("scheduler")
}
