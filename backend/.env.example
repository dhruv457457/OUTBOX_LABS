# Supabase Postgres — get these from Project Settings > Database
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project URL — used to verify session JWTs against Supabase's public JWKS
SUPABASE_URL="https://xxxx.supabase.co"

# Redis
REDIS_URL="redis://localhost:6379"

# Ethereal Email — generate a test account at https://ethereal.email
ETHEREAL_USER="your-ethereal-user"
ETHEREAL_PASS="your-ethereal-pass"

# Scheduler behavior — no hardcoded defaults in code, everything comes from here
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=200

PORT=4000

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN="http://localhost:3000"

# Mailboxes provisioned for each new account ("email|Display Name", comma-separated)
DEFAULT_SENDERS="outreach@outbox-demo.dev|Outreach,sales@outbox-demo.dev|Sales,hello@outbox-demo.dev|Hello"

# API requests per minute per IP
RATE_LIMIT_PER_MINUTE=120

# Compose assistant — optional, the magic-wand button hides when unset.
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=""
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="openai/gpt-4o-mini"

# Attachment storage — optional, the paperclip hides when unset.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# Run the queue worker inside the API process. Leave false locally (the worker runs
# separately, which is what the restart test kills); set true on hosts that only give
# you one process, such as Render's free plan.
RUN_WORKER_IN_API="false"
