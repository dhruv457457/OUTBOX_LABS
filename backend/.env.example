# Supabase Postgres — get these from Project Settings > Database
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase Auth — Project Settings > API
SUPABASE_JWT_SECRET="your-jwt-secret"

# Redis
REDIS_URL="redis://localhost:6379"

# Ethereal Email — generate a test account at https://ethereal.email
ETHEREAL_USER="your-ethereal-user"
ETHEREAL_PASS="your-ethereal-pass"

# Scheduler behavior — no hardcoded defaults in code, everything comes from here
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=200

PORT=4000
